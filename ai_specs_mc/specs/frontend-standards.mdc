### Component Conventions

#### Functional Components
- **Always use functional components** with hooks
- Use **TypeScript** for all new components (`.tsx`)
- Keep components focused on a single responsibility

```typescript
import React, { useState, useEffect } from "react";

type ModemCellProps = {
    port: string;
    status: "registered" | "unregistered" | "error" | "empty" | "switching";
    phone?: string;
    iccid?: string;
    onClick?: (port: string) => void;
};

const ModemCell: React.FC<ModemCellProps> = ({ port, status, phone, iccid, onClick }) => {
    const statusColors: Record<string, string> = {
        registered: "#4caf50",
        unregistered: "#ffeb3b",
        error: "#f44336",
        empty: "#9e9e9e",
        switching: "#2196f3",
    };

    return (
        <div
            className="modem-cell"
            style={{ backgroundColor: statusColors[status] }}
            onClick={() => onClick?.(port)}
            title={`${phone || "N/A"} | ${iccid || "N/A"}`}
        >
            {port}
        </div>
    );
};

export default ModemCell;
```

### State Management

- Use **useState** for component-level state
- Use **useEffect** for side effects and data fetching
- **Extract custom hooks** for reusable stateful logic
- No global state library required unless complexity demands it

```typescript
// Custom hook for polling data
function usePoolData(poolId: number, intervalMs: number = 30000) {
    const [data, setData] = useState<PoolData | null>(null);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState<string | null>(null);

    useEffect(() => {
        const fetchData = async () => {
            try {
                const result = await poolService.getPoolStatus(poolId);
                setData(result);
                setError(null);
            } catch (err) {
                setError("Failed to fetch pool data");
            } finally {
                setLoading(false);
            }
        };

        fetchData();
        const interval = setInterval(fetchData, intervalMs);
        return () => clearInterval(interval);
    }, [poolId, intervalMs]);

    return { data, loading, error };
}
```

### Service Layer Architecture

- **Centralize API calls** in service files
- Use **axios** for HTTP requests
- **Handle errors at service level**
- Use environment variables for API base URL

```typescript
import axios from "axios";

const API_BASE_URL = process.env.REACT_APP_API_URL || "http://localhost:5000/api";

export const poolService = {
    getPoolStatus: async (poolId: number) => {
        const response = await axios.get(`${API_BASE_URL}/pools/${poolId}`);
        return response.data;
    },

    getModemGrid: async (poolId: number) => {
        const response = await axios.get(`${API_BASE_URL}/pools/${poolId}/grid`);
        return response.data;
    },
};
```

### Navigation Patterns

- Use **React Router** for all navigation
- Use **programmatic navigation** with `useNavigate`
- Keep route definitions centralized

```typescript
import { BrowserRouter, Routes, Route } from "react-router-dom";

function App() {
    return (
        <BrowserRouter>
            <Routes>
                <Route path="/" element={<Dashboard />} />
                <Route path="/pools/:poolId" element={<PoolDetail />} />
                <Route path="/scans" element={<ScanResults />} />
            </Routes>
        </BrowserRouter>
    );
}
```

